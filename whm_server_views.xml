<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM SERVER VIEWS
       ============================================================ -->

  <!-- Tree View -->
  <record id="view_whm_server_tree" model="ir.ui.view">
    <field name="name">whm.server.tree</field>
    <field name="model">whm.server</field>
    <field name="arch" type="xml">
      <list string="WHM Servers" decoration-success="status == 'online'"
            decoration-danger="status == 'error'"
            decoration-warning="status == 'offline'">
        <field name="name"/>
        <field name="hostname"/>
        <field name="ip_address"/>
        <field name="whm_version"/>
        <field name="current_accounts"/>
        <field name="max_accounts"/>
        <field name="status" widget="badge"
               decoration-success="status == 'online'"
               decoration-danger="status == 'error'"
               decoration-warning="status == 'offline'"/>
        <field name="is_active"/>
        <field name="last_sync"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_whm_server_form" model="ir.ui.view">
    <field name="name">whm.server.form</field>
    <field name="model">whm.server</field>
    <field name="arch" type="xml">
      <form string="WHM Server">
        <header>
          <button name="action_test_connection" string="Test Connection"
                  type="object" class="btn-primary"/>
          <button name="action_sync_server_info" string="Sync Server Info"
                  type="object" class="btn-info"/>
          <button name="action_sync_resource_usage" string="Sync Resource Usage"
                  type="object" class="btn-secondary"/>
          <button name="action_sync_packages" string="Sync Packages"
                  type="object" class="btn-secondary"/>
          <field name="status" widget="statusbar"
                 statusbar_visible="offline,online,error"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_sync_server_info" type="object" class="oe_stat_button" icon="fa-server">
              <field name="current_accounts" widget="statinfo" string="Accounts"/>
            </button>
            <button name="action_sync_resource_usage" type="object" class="oe_stat_button" icon="fa-hdd-o">
              <field name="used_disk_space" widget="statinfo" string="Disk Used (GB)"/>
            </button>
          </div>
          
          <group>
            <group string="Server Information">
              <field name="name"/>
              <field name="hostname"/>
              <field name="ip_address"/>
              <field name="is_active"/>
            </group>
            <group string="API Configuration">
              <field name="api_url" placeholder="https://server.example.com:2087"/>
              <field name="api_token" password="True"/>
              <field name="verify_ssl"/>
            </group>
          </group>
          
          <group string="Server Details">
            <group>
              <field name="whm_version" readonly="1"/>
              <field name="php_version" readonly="1"/>
              <field name="mysql_version" readonly="1"/>
              <field name="cpanel_version" readonly="1"/>
            </group>
            <group>
              <field name="last_sync" readonly="1"/>
              <field name="max_accounts"/>
              <field name="default_domain"/>
              <field name="from_email"/>
            </group>
          </group>
          
          <group string="Resource Statistics" invisible="status != 'online'">
            <group>
              <field name="total_disk_space" readonly="1"/>
              <field name="used_disk_space" readonly="1"/>
              <field name="total_memory" readonly="1"/>
              <field name="used_memory" readonly="1"/>
            </group>
            <group>
              <field name="current_accounts" readonly="1"/>
              <field name="nameservers" widget="text"/>
            </group>
          </group>
          
          <group string="Account Limits">
            <group>
              <field name="max_accounts"/>
            </group>
            <group>
              <field name="current_accounts" readonly="1"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Kanban View -->
  <record id="view_whm_server_kanban" model="ir.ui.view">
    <field name="name">whm.server.kanban</field>
    <field name="model">whm.server</field>
    <field name="arch" type="xml">
      <kanban string="WHM Servers" default_group_by="status">
        <field name="name"/>
        <field name="hostname"/>
        <field name="ip_address"/>
        <field name="whm_version"/>
        <field name="current_accounts"/>
        <field name="max_accounts"/>
        <field name="status"/>
        <field name="is_active"/>
        <field name="last_sync"/>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
              <div class="o_kanban_card_header">
                <div class="o_kanban_manage_header_section">
                  <strong class="o_kanban_record_title">
                    <field name="name"/>
                  </strong>
                </div>
                <div class="o_kanban_manage_header_section">
                  <span class="badge badge-#{record.status.raw_value == 'online' ? 'success' : record.status.raw_value == 'error' ? 'danger' : 'warning'}">
                    <field name="status"/>
                  </span>
                </div>
              </div>
              <div class="o_kanban_card_content">
                <div class="row">
                  <div class="col-6">
                    <strong>Hostname:</strong><br/>
                    <field name="hostname"/>
                  </div>
                  <div class="col-6">
                    <strong>IP Address:</strong><br/>
                    <field name="ip_address"/>
                  </div>
                </div>
                <div class="row mt-2">
                  <div class="col-6">
                    <strong>WHM Version:</strong><br/>
                    <field name="whm_version"/>
                  </div>
                  <div class="col-6">
                    <strong>Accounts:</strong><br/>
                    <field name="current_accounts"/> / <field name="max_accounts"/>
                  </div>
                </div>
                <div class="row mt-2" t-if="record.last_sync.raw_value">
                  <div class="col-12">
                    <strong>Last Sync:</strong>
                    <field name="last_sync"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_whm_server_search" model="ir.ui.view">
    <field name="name">whm.server.search</field>
    <field name="model">whm.server</field>
    <field name="arch" type="xml">
      <search string="WHM Servers">
        <field name="name"/>
        <field name="hostname"/>
        <field name="ip_address"/>
        <field name="status"/>
        
        <filter string="Online" name="online" domain="[('status', '=', 'online')]"/>
        <filter string="Offline" name="offline" domain="[('status', '=', 'offline')]"/>
        <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
        <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
        <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
        
        <separator/>
        <filter string="Recently Synced" name="recent_sync" 
                domain="[('last_sync', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
        
        <group expand="0" string="Group By">
          <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
          <filter string="Active" name="group_active" context="{'group_by': 'is_active'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_whm_server" model="ir.actions.act_window">
    <field name="name">WHM Servers</field>
    <field name="res_model">whm.server</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Add your first WHM server
      </p>
      <p>
        WHM servers are the physical or virtual servers running cPanel/WHM where 
        hosting accounts are created and managed. Configure your server details 
        and API credentials to get started.
      </p>
    </field>
  </record>

</odoo>
