<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM PACKAGE VIEWS
       ============================================================ -->

  <!-- Tree View -->
  <record id="view_whm_package_tree" model="ir.ui.view">
    <field name="name">whm.package.tree</field>
    <field name="model">whm.package</field>
    <field name="arch" type="xml">
      <list string="Hosting Packages" decoration-success="is_active == True"
            decoration-muted="is_active == False">
        <field name="name"/>
        <field name="server_id"/>
        <field name="disk_quota"/>
        <field name="bandwidth_limit"/>
        <field name="max_addon_domains"/>
        <field name="max_email_accounts"/>
        <field name="monthly_price"/>
        <field name="is_featured" widget="boolean_toggle"/>
        <field name="is_active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_whm_package_form" model="ir.ui.view">
    <field name="name">whm.package.form</field>
    <field name="model">whm.package</field>
    <field name="arch" type="xml">
      <form string="Hosting Package">
        <header>
          <button name="action_create_in_whm" string="Create in WHM"
                  type="object" class="btn-primary"
                  invisible="server_id == False"/>
          <button name="action_update_in_whm" string="Update in WHM"
                  type="object" class="btn-info"
                  invisible="server_id == False"/>
          <button name="action_delete_from_whm" string="Delete from WHM"
                  type="object" class="btn-danger"
                  confirm="Are you sure you want to delete this package from WHM?"
                  invisible="server_id == False"/>
          <button name="action_sync_from_whm" string="Sync from WHM"
                  type="object" class="btn-secondary"
                  invisible="server_id == False"/>
          <field name="is_active" widget="boolean_toggle"/>
          <field name="is_featured" widget="boolean_toggle"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" icon="fa-server">
              <field name="hosting_account_ids" widget="statinfo" string="Accounts"/>
            </button>
            <button class="oe_stat_button" icon="fa-dollar">
              <field name="monthly_price" widget="statinfo" string="Monthly Price"/>
            </button>
          </div>
          
          <group>
            <group string="Package Information">
              <field name="name"/>
              <field name="server_id"/>
              <field name="description"/>
              <field name="is_reseller"/>
            </group>
            <group string="Status">
              <field name="is_active"/>
              <field name="is_featured"/>
            </group>
          </group>
          
          <group string="Resource Limits">
            <group>
              <field name="disk_quota"/>
              <field name="bandwidth_limit"/>
              <field name="max_addon_domains"/>
              <field name="max_parked_domains"/>
            </group>
            <group>
              <field name="max_subdomains"/>
              <field name="max_email_accounts"/>
              <field name="max_databases"/>
              <field name="max_ftp_accounts"/>
            </group>
          </group>
          
          <group string="Features">
            <group>
              <field name="cgi_access"/>
              <field name="php_access"/>
              <field name="ssl_access"/>
              <field name="shell_access"/>
            </group>
            <group t-if="is_reseller">
              <field name="max_accounts"/>
            </group>
          </group>
          
          <group string="Pricing">
            <group>
              <field name="setup_fee"/>
              <field name="monthly_price"/>
              <field name="quarterly_price"/>
            </group>
            <group>
              <field name="semi_annual_price"/>
              <field name="annual_price"/>
              <field name="biennial_price"/>
            </group>
          </group>
          
          <notebook>
            <page string="Resource Summary">
              <group>
                <field name="resource_summary" readonly="1" widget="text"/>
              </group>
            </page>
            
            <page string="Hosting Accounts">
              <field name="hosting_account_ids" nolabel="1">
                <tree>
                  <field name="name"/>
                  <field name="partner_id"/>
                  <field name="cpanel_username"/>
                  <field name="state"/>
                  <field name="create_date"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Kanban View -->
  <record id="view_whm_package_kanban" model="ir.ui.view">
    <field name="name">whm.package.kanban</field>
    <field name="model">whm.package</field>
    <field name="arch" type="xml">
      <kanban string="Hosting Packages" default_group_by="is_active">
        <field name="name"/>
        <field name="server_id"/>
        <field name="disk_quota"/>
        <field name="bandwidth_limit"/>
        <field name="max_addon_domains"/>
        <field name="max_email_accounts"/>
        <field name="monthly_price"/>
        <field name="is_active"/>
        <field name="is_featured"/>
        <field name="is_reseller"/>
        <field name="hosting_account_ids"/>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
              <div class="o_kanban_card_header">
                <div class="o_kanban_manage_header_section">
                  <strong class="o_kanban_record_title">
                    <field name="name"/>
                    <span t-if="record.is_featured.raw_value" class="badge badge-warning ms-1">Featured</span>
                  </strong>
                </div>
                <div class="o_kanban_manage_header_section">
                  <span class="badge badge-#{record.is_active.raw_value ? 'success' : 'secondary'}">
                    <field name="is_active"/>
                  </span>
                </div>
              </div>
              <div class="o_kanban_card_content">
                <div class="row">
                  <div class="col-6">
                    <strong>Server:</strong><br/>
                    <field name="server_id"/>
                  </div>
                  <div class="col-6">
                    <strong>Type:</strong><br/>
                    <span t-if="record.is_reseller.raw_value" class="badge badge-info">Reseller</span>
                    <span t-else="" class="badge badge-primary">Hosting</span>
                  </div>
                </div>
                <div class="row mt-2">
                  <div class="col-6">
                    <strong>Disk:</strong> <field name="disk_quota"/> MB
                  </div>
                  <div class="col-6">
                    <strong>Bandwidth:</strong> <field name="bandwidth_limit"/> MB
                  </div>
                </div>
                <div class="row mt-2">
                  <div class="col-6">
                    <strong>Monthly Price:</strong><br/>
                    $<field name="monthly_price"/>
                  </div>
                  <div class="col-6">
                    <strong>Accounts:</strong><br/>
                    <field name="hosting_account_ids" widget="badge"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_whm_package_search" model="ir.ui.view">
    <field name="name">whm.package.search</field>
    <field name="model">whm.package</field>
    <field name="arch" type="xml">
      <search string="Hosting Packages">
        <field name="name"/>
        <field name="server_id"/>
        <field name="description"/>
        
        <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
        <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
        <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
        <filter string="Reseller" name="reseller" domain="[('is_reseller', '=', True)]"/>
        <filter string="Regular" name="regular" domain="[('is_reseller', '=', False)]"/>
        
        <separator/>
        <filter string="With Accounts" name="with_accounts" domain="[('hosting_account_ids', '!=', False)]"/>
        
        <group expand="0" string="Group By">
          <filter string="Server" name="group_server" context="{'group_by': 'server_id'}"/>
          <filter string="Type" name="group_type" context="{'group_by': 'is_reseller'}"/>
          <filter string="Status" name="group_status" context="{'group_by': 'is_active'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_whm_package" model="ir.actions.act_window">
    <field name="name">Hosting Packages</field>
    <field name="res_model">whm.package</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first hosting package
      </p>
      <p>
        Hosting packages define the resources and limits available to customers.
        Create packages that match your service offerings and sync them with WHM.
      </p>
    </field>
  </record>

</odoo>
