<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM TLD VIEWS
       ============================================================ -->

  <!-- Tree View -->
  <record id="view_whm_tld_tree" model="ir.ui.view">
    <field name="name">whm.tld.tree</field>
    <field name="model">whm.tld</field>
    <field name="arch" type="xml">
      <list string="TLDs" decoration-success="is_active == True"
            decoration-muted="is_active == False">
        <field name="name"/>
        <field name="description"/>
        <field name="registration_price"/>
        <field name="transfer_price"/>
        <field name="renewal_price"/>
        <field name="is_restricted" widget="boolean_toggle"/>
        <field name="is_featured" widget="boolean_toggle"/>
        <field name="is_active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_whm_tld_form" model="ir.ui.view">
    <field name="name">whm.tld.form</field>
    <field name="model">whm.tld</field>
    <field name="arch" type="xml">
      <form string="TLD">
        <header>
          <field name="is_active" widget="boolean_toggle"/>
          <field name="is_featured" widget="boolean_toggle"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" icon="fa-globe">
              <field name="domain_ids" widget="statinfo" string="Domains"/>
            </button>
            <button class="oe_stat_button" icon="fa-dollar">
              <field name="registration_price" widget="statinfo" string="Registration"/>
            </button>
          </div>
          
          <group>
            <group string="TLD Information">
              <field name="name"/>
              <field name="description"/>
              <field name="is_active"/>
              <field name="is_featured"/>
            </group>
            <group string="Pricing">
              <field name="registration_price"/>
              <field name="transfer_price"/>
              <field name="renewal_price"/>
              <field name="whois_privacy_price"/>
            </group>
          </group>
          
          <group string="Registration Requirements">
            <group>
              <field name="min_years"/>
              <field name="max_years"/>
              <field name="is_restricted"/>
            </group>
            <group>
              <field name="whois_privacy_available"/>
              <field name="requires_glue_records"/>
            </group>
          </group>
          
          <group string="Registry Information">
            <group>
              <field name="registry_name"/>
              <field name="registry_url"/>
              <field name="grace_period_days"/>
              <field name="redemption_period_days"/>
            </group>
            <group>
              <field name="idn_supported"/>
              <field name="dnssec_supported"/>
            </group>
          </group>
          
          <group string="Restrictions" t-if="is_restricted">
            <group colspan="2">
              <field name="restriction_description" widget="text"/>
            </group>
          </group>
          
          <group string="Nameserver Requirements" t-if="requires_glue_records">
            <group colspan="2">
              <field name="nameserver_requirements" widget="text"/>
            </group>
          </group>
          
          <notebook>
            <page string="Statistics">
              <group>
                <group>
                  <field name="domain_ids" readonly="1"/>
                  <field name="get_domain_count" readonly="1"/>
                </group>
                <group>
                  <field name="get_active_domain_count" readonly="1"/>
                  <field name="get_expiring_soon_count" readonly="1"/>
                </group>
              </group>
            </page>
            
            <page string="Registrar TLDs">
              <field name="registrar_tld_ids" nolabel="1">
                <tree>
                  <field name="registrar_id"/>
                  <field name="is_active"/>
                  <field name="pricing_override"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_whm_tld_search" model="ir.ui.view">
    <field name="name">whm.tld.search</field>
    <field name="model">whm.tld</field>
    <field name="arch" type="xml">
      <search string="TLDs">
        <field name="name"/>
        <field name="description"/>
        <field name="registry_name"/>
        
        <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
        <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
        <filter string="Featured" name="featured" domain="[('is_featured', '=', True)]"/>
        <filter string="Restricted" name="restricted" domain="[('is_restricted', '=', True)]"/>
        <filter string="WHOIS Privacy Available" name="whois_privacy" domain="[('whois_privacy_available', '=', True)]"/>
        
        <separator/>
        <filter string="With Domains" name="with_domains" domain="[('domain_ids', '!=', False)]"/>
        
        <group expand="0" string="Group By">
          <filter string="Registry" name="group_registry" context="{'group_by': 'registry_name'}"/>
          <filter string="Status" name="group_status" context="{'group_by': 'is_active'}"/>
          <filter string="Type" name="group_type" context="{'group_by': 'is_restricted'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_whm_tld" model="ir.actions.act_window">
    <field name="name">TLD Management</field>
    <field name="res_model">whm.tld</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Configure TLD pricing and requirements
      </p>
      <p>
        Top-level domains (TLDs) define the pricing and registration requirements 
        for different domain extensions like .com, .org, .co.za, etc.
      </p>
    </field>
  </record>

</odoo>
