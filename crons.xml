    <field name="interval_type">weeks</field>
    <field name="active">False</field>
    <field name="doall">False</field>
    <field name="numbercall">-1</field>
    <field name="priority">50</field>
  </record>

  <!-- Auto-suspend Overdue Accounts -->
  <record id="cron_whm_auto_suspend" model="ir.cron">
    <field name="name">WHM: Auto-suspend Overdue Accounts</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="state">code</field>
    <field name="code">model.cron_auto_suspend_overdue()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">False</field>
    <field name="doall">False</field>
    <field name="numbercall">-1</field>
    <field name="priority">55</field>
  </record>

  <!-- Send Renewal Reminders -->
  <record id="cron_whm_renewal_reminders" model="ir.cron">
    <field name="name">WHM: Send Renewal Reminders</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="state">code</field>
    <field name="code">model.cron_send_renewal_reminders()</field>
