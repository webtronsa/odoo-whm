    <field name="model_id" ref="model_whm_ssl_certificate"/>
    <field name="state">code</field>
    <field name="code">model.cron_check_ssl_renewal()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
    <field name="doall">False</field>
    <field name="numbercall">-1</field>
    <field name="priority">65</field>
  </record>

  <!-- Generate Invoices -->
  <record id="cron_whm_generate_invoices" model="ir.cron">
    <field name="name">WHM: Generate Recurring Invoices</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="state">code</field>
    <field name="code">model.cron_generate_recurring_invoices()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active">True</field>
    <field name="doall">False</field>
    <field name="numbercall">-1</field>
    <field name="priority">70</field>
  </record>

  <!-- Monitor Resource Usage -->
  <record id="cron_whm_monitor_resources" model="ir.cron">
    <field name="name">WHM: Monitor Resource Usage</field>
    <field name="model_id" ref="model_whm_server"/>
    <field name="state">code</field>
    <field name="code">model.cron_monitor_resource_usage()</field>
    <field name="interval_number">30</field>
    <field name="interval_type">minutes</field>
    <field name="active">True</field>
    <field name="doall">False</field>
    <field name="numbercall">-1</field>
    <field name="priority">75</field>
  </record>

</odoo>
