<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM BACKEND MENU STRUCTURE
       ============================================================ -->

  <!-- Main WHM Menu -->
  <menuitem id="menu_whm_root" name="WHM Hosting" sequence="50" web_icon="whm_hosting,static/description/icon.png"/>

  <!-- Dashboard Menu -->
  <menuitem id="menu_whm_dashboard" name="Dashboard" parent="menu_whm_root" sequence="10" action="action_whm_dashboard"/>

  <!-- Servers Menu -->
  <menuitem id="menu_whm_servers" name="Servers" parent="menu_whm_root" sequence="20"/>
  <menuitem id="menu_whm_servers_list" name="WHM Servers" parent="menu_whm_servers" sequence="10" action="action_whm_server"/>

  <!-- Packages Menu -->
  <menuitem id="menu_whm_packages" name="Packages" parent="menu_whm_root" sequence="30"/>
  <menuitem id="menu_whm_packages_list" name="Hosting Packages" parent="menu_whm_packages" sequence="10" action="action_whm_package"/>

  <!-- Hosting Accounts Menu -->
  <menuitem id="menu_whm_hosting" name="Hosting Accounts" parent="menu_whm_root" sequence="40"/>
  <menuitem id="menu_whm_hosting_accounts" name="All Accounts" parent="menu_whm_hosting" sequence="10" action="action_whm_hosting_account"/>
  
  <!-- Sub-menus for Hosting Accounts -->
  <menuitem id="menu_whm_hosting_active" name="Active Accounts" parent="menu_whm_hosting" sequence="20" 
           action="action_whm_hosting_account_active"/>
  <menuitem id="menu_whm_hosting_pending" name="Pending Setup" parent="menu_whm_hosting" sequence="30" 
           action="action_whm_hosting_account_pending"/>
  <menuitem id="menu_whm_hosting_suspended" name="Suspended Accounts" parent="menu_whm_hosting" sequence="40" 
           action="action_whm_hosting_account_suspended"/>

  <!-- Domains Menu -->
  <menuitem id="menu_whm_domains" name="Domains" parent="menu_whm_root" sequence="50"/>
  <menuitem id="menu_whm_domains_list" name="All Domains" parent="menu_whm_domains" sequence="10" action="action_whm_domain"/>
  <menuitem id="menu_whm_tlds" name="TLD Management" parent="menu_whm_domains" sequence="20" action="action_whm_tld"/>

  <!-- Billing Menu -->
  <menuitem id="menu_whm_billing" name="Billing" parent="menu_whm_root" sequence="60"/>
  <menuitem id="menu_whm_billing_overview" name="Billing Overview" parent="menu_whm_billing" sequence="10" action="action_whm_billing_overview"/>
  <menuitem id="menu_whm_invoices" name="WHM Invoices" parent="menu_whm_billing" sequence="20" action="action_whm_invoices"/>

  <!-- Reports Menu -->
  <menuitem id="menu_whm_reports" name="Reports" parent="menu_whm_root" sequence="70"/>
  <menuitem id="menu_whm_reports_usage" name="Usage Reports" parent="menu_whm_reports" sequence="10" action="action_whm_usage_report"/>
  <menuitem id="menu_whm_reports_revenue" name="Revenue Reports" parent="menu_whm_reports" sequence="20" action="action_whm_revenue_report"/>

  <!-- Configuration Menu -->
  <menuitem id="menu_whm_config" name="Configuration" parent="menu_whm_root" sequence="80"/>
  <menuitem id="menu_whm_config_settings" name="WHM Settings" parent="menu_whm_config" sequence="10" action="action_whm_config_settings"/>
  <menuitem id="menu_whm_config_automation" name="Automation Rules" parent="menu_whm_config" sequence="20" action="action_whm_automation"/>

  <!-- ============================================================
       WHM ACTIONS
       ============================================================ -->

  <!-- Dashboard Action -->
  <record id="action_whm_dashboard" model="ir.actions.act_window">
    <field name="name">WHM Dashboard</field>
    <field name="res_model">whm.dashboard</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <!-- Server Actions -->
  <record id="action_whm_server" model="ir.actions.act_window">
    <field name="name">WHM Servers</field>
    <field name="res_model">whm.server</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Add your first WHM server
      </p>
      <p>
        WHM servers are the physical or virtual servers running cPanel/WHM where 
        hosting accounts are created and managed.
      </p>
    </field>
  </record>

  <!-- Package Actions -->
  <record id="action_whm_package" model="ir.actions.act_window">
    <field name="name">Hosting Packages</field>
    <field name="res_model">whm.package</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first hosting package
      </p>
      <p>
        Hosting packages define the resources and limits available to customers.
        They can be synced with WHM packages or created independently.
      </p>
    </field>
  </record>

  <!-- Hosting Account Actions -->
  <record id="action_whm_hosting_account_active" model="ir.actions.act_window">
    <field name="name">Active Hosting Accounts</field>
    <field name="res_model">whm.hosting.account</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('state', '=', 'active')]</field>
    <field name="context">{'default_state': 'active'}</field>
  </record>

  <record id="action_whm_hosting_account_pending" model="ir.actions.act_window">
    <field name="name">Pending Hosting Accounts</field>
    <field name="res_model">whm.hosting.account</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('state', '=', 'pending')]</field>
    <field name="context">{'default_state': 'pending'}</field>
  </record>

  <record id="action_whm_hosting_account_suspended" model="ir.actions.act_window">
    <field name="name">Suspended Hosting Accounts</field>
    <field name="res_model">whm.hosting.account</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('state', '=', 'suspended')]</field>
    <field name="context">{'default_state': 'suspended'}</field>
  </record>

  <!-- Domain Actions -->
  <record id="action_whm_domain" model="ir.actions.act_window">
    <field name="name">Domains</field>
    <field name="res_model">whm.domain</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No domains found
      </p>
      <p>
        Domains are automatically created when hosting accounts are set up with custom domains.
        You can also add domains manually and manage their DNS settings.
      </p>
    </field>
  </record>

  <record id="action_whm_tld" model="ir.actions.act_window">
    <field name="name">TLD Management</field>
    <field name="res_model">whm.tld</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Configure TLD pricing and requirements
      </p>
      <p>
        Top-level domains (TLDs) define the pricing and registration requirements 
        for different domain extensions like .com, .org, .co.za, etc.
      </p>
    </field>
  </record>

  <!-- Billing Actions -->
  <record id="action_whm_billing_overview" model="ir.actions.act_window">
    <field name="name">WHM Billing Overview</field>
    <field name="res_model">whm.billing.overview</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <record id="action_whm_invoices" model="ir.actions.act_window">
    <field name="name">WHM Invoices</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('invoice_line_ids.product_id.is_whm_product', '=', True)]</field>
    <field name="context">{'default_move_type': 'out_invoice'}</field>
  </record>

  <!-- Report Actions -->
  <record id="action_whm_usage_report" model="ir.actions.act_window">
    <field name="name">Usage Reports</field>
    <field name="res_model">whm.usage.report</field>
    <field name="view_mode">pivot,graph,tree</field>
  </record>

  <record id="action_whm_revenue_report" model="ir.actions.act_window">
    <field name="name">Revenue Reports</field>
    <field name="res_model">whm.revenue.report</field>
    <field name="view_mode">pivot,graph,tree</field>
  </record>

  <!-- Configuration Actions -->
  <record id="action_whm_config_settings" model="ir.actions.act_window">
    <field name="name">WHM Settings</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{'module': 'whm_hosting'}</field>
  </record>

  <record id="action_whm_automation" model="ir.actions.act_window">
    <field name="name">Automation Rules</field>
    <field name="res_model">whm.automation.rule</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create automation rules
      </p>
      <p>
        Automation rules allow you to automatically perform actions based on 
        triggers like account creation, suspension, or resource usage thresholds.
      </p>
    </field>
  </record>

</odoo>
