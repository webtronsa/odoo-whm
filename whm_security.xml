<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM USER GROUPS
       ============================================================ -->

  <!-- WHM Customer Group -->
  <record id="group_whm_customer" model="res.groups">
    <field name="name">WHM Customer</field>
    <field name="comment">Can access own WHM services through portal</field>
    <field name="category_id" ref="base.module_category_website"/>
  </record>

  <!-- WHM Operator Group -->
  <record id="group_whm_operator" model="res.groups">
    <field name="name">WHM Operator</field>
    <field name="comment">Can manage WHM accounts and basic operations</field>
    <field name="category_id" ref="base.module_category_operations"/>
    <field name="implied_ids" eval="[(4, ref('group_whm_customer'))]"/>
  </record>

  <!-- WHM Manager Group -->
  <record id="group_whm_manager" model="res.groups">
    <field name="name">WHM Manager</field>
    <field name="comment">Full access to WHM management features</field>
    <field name="category_id" ref="base.module_category_management"/>
    <field name="implied_ids" eval="[(4, ref('group_whm_operator'))]"/>
  </record>

  <!-- WHM Administrator Group -->
  <record id="group_whm_admin" model="res.groups">
    <field name="name">WHM Administrator</field>
    <field name="comment">Full administrative access to WHM system</field>
    <field name="category_id" ref="base.module_category_administration"/>
    <field name="implied_ids" eval="[(4, ref('group_whm_manager'))]"/>
    <field name="users" eval="[(4, ref('base.user_root'))]"/>
  </record>

  <!-- ============================================================
       WHM ACCESS RIGHTS
       ============================================================ -->

  <!-- Server Access Rules -->
  <record id="rule_whm_server_operator" model="ir.rule">
    <field name="name">WHM Server Operator Access</field>
    <field name="model_id" ref="model_whm_server"/>
    <field name="domain_force">[('is_active', '=', True)]</field>
    <field name="groups" eval="[(4, ref('group_whm_operator'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Hosting Account Access Rules -->
  <record id="rule_whm_hosting_account_customer" model="ir.rule">
    <field name="name">WHM Hosting Account Customer Access</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('group_whm_customer'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record id="rule_whm_hosting_account_operator" model="ir.rule">
    <field name="name">WHM Hosting Account Operator Access</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('group_whm_operator'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Domain Access Rules -->
  <record id="rule_whm_domain_customer" model="ir.rule">
    <field name="name">WHM Domain Customer Access</field>
    <field name="model_id" ref="model_whm_domain"/>
    <field name="domain_force">[('hosting_account_id.partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('group_whm_customer'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Package Access Rules -->
  <record id="rule_whm_package_operator" model="ir.rule">
    <field name="name">WHM Package Operator Access</field>
    <field name="model_id" ref="model_whm_package"/>
    <field name="domain_force">[('is_active', '=', True)]</field>
    <field name="groups" eval="[(4, ref('group_whm_operator'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- ============================================================
       MENU ACCESS RIGHTS
       ============================================================ -->

  <!-- WHM Customer Menu Access -->
  <record id="menu_whm_customer_access" model="ir.ui.menu">
    <field name="name">WHM Customer Portal</field>
    <field name="parent_id" ref="portal.menu_portal"/>
    <field name="sequence" eval="50"/>
    <field name="groups_id" eval="[(4, ref('group_whm_customer'))]"/>
  </record>

  <!-- WHM Operator Menu Access -->
  <record model="ir.ui.menu" id="menu_whm_root">
    <field name="groups_id" eval="[(4, ref('group_whm_operator'))]"/>
  </record>

  <!-- WHM Manager Menu Access -->
  <record model="ir.ui.menu" id="menu_whm_config">
    <field name="groups_id" eval="[(4, ref('group_whm_manager'))]"/>
  </record>

  <!-- WHM Admin Menu Access -->
  <record model="ir.ui.menu" id="menu_whm_config_settings">
    <field name="groups_id" eval="[(4, ref('group_whm_admin'))]"/>
  </record>

  <!-- ============================================================
       RECORD RULES FOR SECURITY
       ============================================================ -->

  <!-- Prevent customers from seeing other customers' accounts -->
  <record id="rule_whm_hosting_account_isolation" model="ir.rule">
    <field name="name">WHM Account Isolation</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
  </record>

  <!-- Prevent customers from modifying sensitive fields -->
  <record id="rule_whm_hosting_account_readonly" model="ir.rule">
    <field name="name">WHM Account Read-only Fields</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- ============================================================
       FIELD ACCESS RESTRICTIONS
       ============================================================ -->

  <!-- Hide sensitive fields from customers -->
  <record id="field_access_whm_hosting_account_customer" model="ir.model.fields.access">
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="group_id" ref="group_whm_customer"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- Hide server details from operators -->
  <record id="field_access_whm_server_operator" model="ir.model.fields.access">
    <field name="model_id" ref="model_whm_server"/>
    <field name="group_id" ref="group_whm_operator"/>
    <field name="field_name">api_token</field>
    <field name="perm_read" eval="False"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- ============================================================
       AUDIT LOGGING
   ============================================================ -->

  <!-- Enable audit logging for critical WHM operations -->
  <record id="audit_log_whm_hosting_account" model="auditlog.rule">
    <field name="name">WHM Hosting Account Audit</field>
    <field name="model_id" ref="model_whm_hosting_account"/>
    <field name="log_read" eval="False"/>
    <field name="log_create" eval="True"/>
    <field name="log_write" eval="True"/>
    <field name="log_unlink" eval="True"/>
    <field name="state">subscribed</field>
  </record>

  <record id="audit_log_whm_server" model="auditlog.rule">
    <field name="name">WHM Server Audit</field>
    <field name="model_id" ref="model_whm_server"/>
    <field name="log_read" eval="False"/>
    <field name="log_create" eval="True"/>
    <field name="log_write" eval="True"/>
    <field name="log_unlink" eval="True"/>
    <field name="state">subscribed</field>
  </record>

  <record id="audit_log_whm_package" model="auditlog.rule">
    <field name="name">WHM Package Audit</field>
    <field name="model_id" ref="model_whm_package"/>
    <field name="log_read" eval="False"/>
    <field name="log_create" eval="True"/>
    <field name="log_write" eval="True"/>
    <field name="log_unlink" eval="True"/>
    <field name="state">subscribed</field>
  </record>

</odoo>
