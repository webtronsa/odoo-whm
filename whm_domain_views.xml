<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       WHM DOMAIN VIEWS
       ============================================================ -->

  <!-- Tree View -->
  <record id="view_whm_domain_tree" model="ir.ui.view">
    <field name="name">whm.domain.tree</field>
    <field name="model">whm.domain</field>
    <field name="arch" type="xml">
      <list string="Domains" decoration-success="state == 'active'"
            decoration-warning="state == 'suspended'"
            decoration-info="state == 'pending'"
            decoration-danger="state == 'error'">
        <field name="name"/>
        <field name="hosting_account_id"/>
        <field name="partner_id" string="Customer"/>
        <field name="is_primary" widget="boolean_toggle"/>
        <field name="registration_status"/>
        <field name="expiry_date"/>
        <field name="ssl_enabled" widget="boolean_toggle"/>
        <field name="state" widget="badge"
               decoration-success="state == 'active'"
               decoration-warning="state == 'suspended'"
               decoration-info="state == 'pending'"
               decoration-danger="state == 'error'"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_whm_domain_form" model="ir.ui.view">
    <field name="name">whm.domain.form</field>
    <field name="model">whm.domain</field>
    <field name="arch" type="xml">
      <form string="Domain">
        <header>
          <button name="action_add_to_cpanel" string="Add to cPanel"
                  type="object" class="btn-primary"
                  invisible="state == 'active'"/>
          <button name="action_remove_from_cpanel" string="Remove from cPanel"
                  type="object" class="btn-warning"
                  invisible="state != 'active'"/>
          <button name="action_set_as_primary" string="Set as Primary"
                  type="object" class="btn-info"
                  invisible="is_primary == True"/>
          <button name="action_sync_from_cpanel" string="Sync from cPanel"
                  type="object" class="btn-secondary"
                  invisible="state != 'active'"/>
          <button name="action_install_ssl_certificate" string="Install SSL"
                  type="object" class="btn-success"
                  invisible="ssl_enabled == True"/>
          <button name="action_request_free_ssl" string="Request Free SSL"
                  type="object" class="btn-secondary"
                  invisible="ssl_enabled == True"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="pending,active,suspended"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_sync_from_cpanel" type="object" class="oe_stat_button" icon="fa-hdd-o">
              <field name="disk_usage" widget="statinfo" string="Disk Used (MB)"/>
            </button>
            <button name="action_sync_from_cpanel" type="object" class="oe_stat_button" icon="fa-tachometer-alt">
              <field name="bandwidth_usage" widget="statinfo" string="Bandwidth Used (MB)"/>
            </button>
          </div>
          
          <group>
            <group string="Domain Information">
              <field name="name"/>
              <field name="hosting_account_id"/>
              <field name="partner_id" readonly="1"/>
              <field name="is_primary"/>
            </group>
            <group string="Status">
              <field name="state"/>
              <field name="last_sync" readonly="1"/>
            </group>
          </group>
          
          <group string="Domain Registration">
            <group>
              <field name="is_registered"/>
              <field name="registrar_id"/>
              <field name="registration_date"/>
              <field name="expiry_date"/>
            </group>
            <group>
              <field name="registration_status"/>
              <field name="auto_renew"/>
            </group>
          </group>
          
          <group string="Configuration">
            <group>
              <field name="document_root" readonly="1"/>
              <field name="php_version"/>
              <field name="ssl_enabled"/>
              <field name="ssl_certificate_id"/>
            </group>
            <group>
              <field name="nameservers" widget="text"/>
            </group>
          </group>
          
          <group string="Resource Usage" invisible="state != 'active'">
            <group>
              <field name="disk_usage" readonly="1"/>
              <field name="bandwidth_usage" readonly="1"/>
            </group>
            <group>
              <field name="last_sync" readonly="1"/>
            </group>
          </group>
          
          <notebook>
            <page string="DNS Records">
              <field name="dns_records" nolabel="1">
                <tree>
                  <field name="name"/>
                  <field name="type"/>
                  <field name="value"/>
                  <field name="ttl"/>
                  <field name="is_active"/>
                </tree>
              </field>
            </page>
            
            <page string="SSL Certificate" t-if="ssl_certificate_id">
              <group>
                <field name="ssl_certificate_id"/>
              </group>
            </page>
            
            <page string="Notes">
              <group>
                <field name="notes" widget="text"/>
                <field name="provisioning_notes" readonly="1" widget="text"/>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_whm_domain_search" model="ir.ui.view">
    <field name="name">whm.domain.search</field>
    <field name="model">whm.domain</field>
    <field name="arch" type="xml">
      <search string="Domains">
        <field name="name"/>
        <field name="hosting_account_id"/>
        <field name="partner_id"/>
        <field name="state"/>
        <field name="registration_status"/>
        
        <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
        <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
        <filter string="Suspended" name="suspended" domain="[('state', '=', 'suspended')]"/>
        <filter string="Primary Domains" name="primary" domain="[('is_primary', '=', True)]"/>
        <filter string="SSL Enabled" name="ssl" domain="[('ssl_enabled', '=', True)]"/>
        <filter string="Registered with Us" name="registered" domain="[('is_registered', '=', True)]"/>
        
        <separator/>
        <filter string="Expiring Soon" name="expiring_soon" 
                domain="[('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d')), ('expiry_date', '!=', False)]"/>
        
        <group expand="0" string="Group By">
          <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
          <filter string="Hosting Account" name="group_account" context="{'group_by': 'hosting_account_id'}"/>
          <filter string="Registration Status" name="group_registration" context="{'group_by': 'registration_status'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_whm_domain" model="ir.actions.act_window">
    <field name="name">Domains</field>
    <field name="res_model">whm.domain</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No domains found
      </p>
      <p>
        Domains are automatically created when hosting accounts are set up with custom domains.
        You can also add domains manually and manage their DNS settings.
      </p>
    </field>
  </record>

</odoo>
